{
    "name": "paper-leaf/help-guide",
    "description": "Help Guide provides contextual help and guidance throughout your Filament application, making it easier for users to understand and navigate your application.",
    "keywords": [
        "paper-leaf",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "help-guide"
    ],
    "homepage": "https://github.com/paper-leaf/help-guide",
    "support": {
        "issues": "https://github.com/paper-leaf/help-guide/issues",
        "source": "https://github.com/paper-leaf/help-guide"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Sarah Tinga",
            "email": "sarah@paper-leaf.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "wallacemartinss/filament-icon-picker": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.7|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "pestphp/pest-plugin-livewire": "^3.0|^4.0",
        "rector/rector": "^2.0",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "PaperLeaf\\HelpGuide\\": "src/",
            "PaperLeaf\\HelpGuide\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PaperLeaf\\HelpGuide\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "refactor": "rector",
        "test": "pest",
        "test:lint": "pint --test",
        "test:refactor": "rector --dry-run"
    },
    "extra": {
        "laravel": {
            "providers": [
                "PaperLeaf\\HelpGuide\\HelpGuideServiceProvider"
            ],
            "aliases": {
                "HelpGuide": "PaperLeaf\\HelpGuide\\Facades\\HelpGuide"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
